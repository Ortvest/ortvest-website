# Public URL of this site (used for Stripe cancel_url when subscribing to CMS)
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# Ortvest CMS origin (server-only, no NEXT_PUBLIC_ prefix).
# Used by the blog data layer and the /api/cms-subscribe proxy.
# In development, falls back to http://localhost:3200 if unset.
# REQUIRED in production — the build will fail without it.
ORTVEST_CMS_API_URL=http://localhost:3200

# Secret shared with Ortvest CMS for on-demand ISR revalidation.
# The CMS sends `POST /api/revalidate` with header `x-revalidate-secret: <value>`
# after publishing a post. Without this, the webhook endpoint is disabled.
# Generate with: openssl rand -hex 32
REVALIDATE_SECRET=

# Analytics and consent integrations
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
LINKEDIN_PARTNER_ID=0000000
COOKIEYES_SITE_ID=your-cookieyes-site-id

# MongoDB (contact form, etc.)
MONGODB_URI=mongodb+srv://user:PASS@cluster.mongodb.net/
